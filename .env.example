# LIFE ERP configuration. Copy to ".env" and adjust. Every setting is optional.

# Where your data lives (database, documents, backups, logs).
# Default: C:\Users\<you>\LifeERP-Data   — keep it OUT of OneDrive/Dropbox (sync tools can corrupt a live database).
# LIFE_ERP_DATA_DIR=C:\Users\Admin\LifeERP-Data

# Separate folder for demo data (npm run demo). Default: C:\Users\<you>\LifeERP-Demo
# LIFE_ERP_DEMO_DIR=C:\Users\Admin\LifeERP-Demo

# Port of the web app/API. Default 4600 (demo: 4610).
# PORT=4600

# 1 = phones on your home Wi-Fi can connect (listens on all network interfaces).
# 0 = only this laptop (and Tailscale Serve, which connects locally) can connect.
# LIFE_ERP_LAN=1

# Maximum size of one uploaded document, in MB. Default 100.
# LIFE_ERP_MAX_UPLOAD_MB=100

# How long a sign-in stays valid without use, in days. Default 30.
# LIFE_ERP_SESSION_DAYS=30
